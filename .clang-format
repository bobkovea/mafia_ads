# Версия clang и clang-format: 17.0.6
# Список опций: https://clang.llvm.org/docs/ClangFormatStyleOptions.html

# Ручной запуск для форматирования файла:
# clang-format -i --style=file <file>

# Источник.
Language: Cpp
BasedOnStyle: Microsoft

# Ограничение на ширину текста.
ColumnLimit: 110

# Перенос строки после шаблона.
#   template <class T>\n
#   struct tIsFlagsEnum
AlwaysBreakTemplateDeclarations: Yes

# Всегда переносить скобки.
BreakBeforeBraces: Allman

# Перенос после двоеточия в списке наследования.
BreakInheritanceList: AfterColon

# Перенос после двоеточия в списке инициализаторов класса.
BreakConstructorInitializers: AfterColon

# Разбивать инициализаторы класса.
PackConstructorInitializers: Never

# Отступы между блоками, методами и т.д.
SeparateDefinitionBlocks: Always

# Добавлять // namespace <Name> за скобкой закрытия namespace.
FixNamespaceComments: true

# Не сортировать include. До исправления моков для юнит тестов,
# работающих через подмену типов в порядке включения файлов
SortIncludes: Never

# Не выстраивать короткие блоки в одну строку.
AllowShortBlocksOnASingleLine: Never

# Не выстраивать короткие функции в одну строку.
AllowShortFunctionsOnASingleLine: None

# В начале комментария один пробел или более.
SpacesInLineCommentPrefix:
  Minimum: 1
  Maximum: -1

# Не пытаться упаковывать аргументы/параметры в одну строку попарно,
# когда все сразу не умещаются.
BinPackParameters: false
BinPackArguments: false

# Всегда переносить после открывающей скобки, если параметры не умещаются на одной строке.
AlignAfterOpenBracket: AlwaysBreak

# Если вызов функции или инициализатор в скобках не умещаются на одной строке, разрешить
# перенос всех аргументов на следующую строку, даже если BinPackArguments == false.
AllowAllArgumentsOnNextLine: true

# Если определение функции не умещается на одной строке, разрешить перемещение всех параметров
# на следующей строке, даже если BinPackParameters == OnePerLine.
AllowAllParametersOfDeclarationOnNextLine: true

# Указатели и ссылки выравнивать по левой стороне.
PointerAlignment: Left

# Вставлять запятую в конце списка, который занимает несколько строк.
InsertTrailingCommas: Wrapped
